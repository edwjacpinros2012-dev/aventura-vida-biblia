generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
  MODERATOR
  TEACHER
  FAMILY
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum GameType {
  INTERNAL
  TRUSTED_EMBED
}

enum Difficulty {
  INITIAL
  EXPLORER
  ADVENTURER
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ScorePeriod {
  WEEKLY
  MONTHLY
  SEASON
}

enum MissionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  ARCHIVED
}

enum RewardType {
  XP
  POINTS
  ACHIEVEMENT
  ITEM
}

enum NotificationStatus {
  PENDING
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  ARCHIVE
  LOGIN
}

enum MultiplayerRoomStatus {
  LOBBY
  PLAYING
  FINISHED
  CLOSED
}

enum MultiplayerParticipantStatus {
  CONNECTED
  DISCONNECTED
  LEFT
}

enum ChatMessageStatus {
  VISIBLE
  FILTERED
  HIDDEN
  REMOVED
}

enum ReportReason {
  INAPPROPRIATE_LANGUAGE
  HARASSMENT
  INSULT
  SEXUAL_CONTENT
  THREAT
  SPAM
  PERSONAL_INFORMATION
  INAPPROPRIATE_BEHAVIOR
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum SanctionType {
  WARNING
  SHORT_SUSPENSION
  LONG_SUSPENSION
  BAN
}

enum SanctionStatus {
  ACTIVE
  LIFTED
  EXPIRED
}

enum InventoryItemType {
  AVATAR
  CHARACTER_STYLE
  EFFECT
  SCENERY
  COSMETIC
  SPECIAL_CONTENT
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
}

enum GiftStatus {
  SENT
  RECEIVED
  REJECTED
  CANCELLED
}

enum MatchMode {
  COOPERATIVE
  PVP_FUTURE
}

enum MatchStatus {
  WAITING
  ACTIVE
  FINISHED
  ABANDONED
}

enum MatchPlayerStatus {
  ACTIVE
  DISCONNECTED
  LEFT
  WON
  LOST
  DRAW
}

model User {
  id             String           @id @default(cuid())
  email          String?          @unique
  role           UserRole         @default(PLAYER)
  emailVerified  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profile        Profile?
  gameSessions   GameSession[]
  gameProgress   GameProgress[]
  scores         Score[]
  xpTransactions XpTransaction[]
  missionProgress MissionProgress[]
  achievements   UserAchievement[]
  rewards        Reward[]
  notifications  Notification[]
  auditLogs      AuditLog[]       @relation("AuditActor")
  credential     UserCredential?
  sessions       UserSession[]
  wallet         PlayerWallet?
  inventory      PlayerInventoryItem[]
  coinTransactions AdventureCoinTransaction[]
  sentGifts      AdventureGift[]  @relation("GiftSender")
  receivedGifts  AdventureGift[]  @relation("GiftRecipient")
  blocksCreated  PlayerBlock[]    @relation("Blocker")
  blocksReceived PlayerBlock[]    @relation("Blocked")
  reportsFiled   CommunityReport[] @relation("ReportReporter")
  reportsReceived CommunityReport[] @relation("ReportTarget")
  reportsResolved CommunityReport[] @relation("ReportResolver")
  sanctionsReceived ModerationSanction[] @relation("SanctionTarget")
  sanctionsIssued ModerationSanction[] @relation("SanctionIssuer")
  sanctionsLifted ModerationSanction[] @relation("SanctionLifter")
  chatMessages   SafeChatMessage[]
  matchPlayers   MatchPlayer[]

  @@index([role])
}

model UserCredential {
  userId            String   @id
  passwordHash      String
  passwordUpdatedAt DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  nickname  String   @unique
  avatarKey String   @default("fox")
  level     Int      @default(1)
  totalXp   Int      @default(0)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([points(sort: Desc)])
}

model PlayerWallet {
  userId         String   @id
  adventureCoins Int      @default(0)
  version        Int      @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdventureCoinTransaction {
  id             String   @id @default(cuid())
  userId         String
  amount         Int
  balanceAfter   Int
  reason         String
  sourceId       String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model StoreItem {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String
  type        InventoryItemType
  rarity      ItemRarity        @default(COMMON)
  coinPrice   Int               @default(0)
  criteria    Json?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owners      PlayerInventoryItem[]

  @@index([type, active])
}

model PlayerInventoryItem {
  id         String    @id @default(cuid())
  userId     String
  itemId     String
  source     String
  acquiredAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, acquiredAt(sort: Desc)])
}

model AdventureGift {
  id             String     @id @default(cuid())
  senderId       String
  recipientId    String
  coins          Int        @default(0)
  encouragement  String?
  idempotencyKey String     @unique
  status         GiftStatus @default(SENT)
  createdAt      DateTime   @default(now())
  receivedAt     DateTime?
  sender         User       @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User       @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt(sort: Desc)])
  @@index([recipientId, status])
}

model PlayerBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model GameCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  games       Game[]
}

model Game {
  id                 String        @id @default(cuid())
  slug               String        @unique
  name               String
  shortDescription   String
  description        String?
  coverImageUrl      String?
  categoryId         String?
  suggestedAgeMin    Int?
  suggestedAgeMax    Int?
  difficulty         Difficulty   @default(INITIAL)
  maxPoints          Int           @default(0)
  xpReward           Int           @default(0)
  gameType           GameType      @default(INTERNAL)
  moduleKey          String?       @unique
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  featured           Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  category           GameCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sessions           GameSession[]
  progress           GameProgress[]
  scores             Score[]
  missions           Mission[]
  adventureLinks     AdventureGame[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([featured, status])
}

model GameSession {
  id        String        @id @default(cuid())
  userId    String
  gameId    String
  status    SessionStatus @default(ACTIVE)
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  metadata  Json?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, gameId, startedAt(sort: Desc)])
  @@index([gameId, status])
}

model GameProgress {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  data      Json
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, completed])
}

model Score {
  id         String      @id @default(cuid())
  userId     String
  gameId     String?
  points     Int
  period     ScorePeriod
  periodKey  String
  source     String
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game?       @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([period, periodKey, points(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  sourceId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Mission {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime?
  objective   Json
  xpReward    Int           @default(0)
  pointsReward Int          @default(0)
  status      MissionStatus @default(DRAFT)
  gameId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  game        Game?         @relation(fields: [gameId], references: [id], onDelete: SetNull)
  progress    MissionProgress[]

  @@index([status, startsAt])
}

model MissionProgress {
  id          String   @id @default(cuid())
  missionId   String
  userId      String
  progress    Json
  completedAt DateTime?
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
  @@index([userId, completedAt])
}

model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String?
  criteria    Json
  xpReward    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       UserAchievement[]

  @@index([active])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  metadata      Json?
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt(sort: Desc)])
}

model Adventure {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  summary     String
  description String?
  coverImageUrl String?
  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  chapters    AdventureChapter[]
  games       AdventureGame[]

  @@index([status, featured])
}

model AdventureChapter {
  id          String    @id @default(cuid())
  adventureId String
  chapterNumber Int
  title       String
  summary     String?
  objectives  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adventure   Adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)

  @@unique([adventureId, chapterNumber])
}

model AdventureGame {
  adventureId String
  gameId      String
  sortOrder   Int @default(0)
  adventure   Adventure @relation(fields: [adventureId], references: [id], onDelete: Cascade)
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([adventureId, gameId])
  @@index([gameId])
}

model Reward {
  id          String     @id @default(cuid())
  userId      String
  type        RewardType
  amount      Int?
  label       String
  source      String
  sourceId    String?
  metadata    Json?
  awardedAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, awardedAt(sort: Desc)])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  title     String
  body      String
  status    NotificationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  readAt    DateTime?
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt(sort: Desc)])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String      @id @default(cuid())
  actorId   String?
  action    AuditAction
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime    @default(now())
  actor     User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

model SafeChatMessage {
  id              String            @id @default(cuid())
  roomId          String?
  authorId        String?
  authorPlayerKey String
  text            String
  presetKey       String?
  status          ChatMessageStatus @default(VISIBLE)
  moderationNotes Json?
  createdAt       DateTime          @default(now())
  room            MultiplayerRoom?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
  author          User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reports         CommunityReport[]

  @@index([roomId, createdAt])
  @@index([authorId, createdAt])
}

model CommunityReport {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  roomId         String?
  messageId      String?
  reason         ReportReason
  details        String?
  status         ReportStatus @default(OPEN)
  resolution     String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User?        @relation("ReportTarget", fields: [reportedUserId], references: [id], onDelete: SetNull)
  room           MultiplayerRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  message        SafeChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  resolvedBy     User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId, createdAt])
}

model ModerationSanction {
  id          String         @id @default(cuid())
  userId      String
  issuedById  String?
  type        SanctionType
  status      SanctionStatus @default(ACTIVE)
  reason      String
  startsAt    DateTime       @default(now())
  endsAt      DateTime?
  liftedAt    DateTime?
  liftedById  String?
  createdAt   DateTime       @default(now())
  user        User           @relation("SanctionTarget", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy    User?          @relation("SanctionIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  liftedBy    User?          @relation("SanctionLifter", fields: [liftedById], references: [id], onDelete: SetNull)

  @@index([userId, status, endsAt])
}

// Las salas no guardan nombres reales ni datos de contacto. `playerKey` es un
// identificador efímero del dispositivo hasta que exista autenticación segura.
model MultiplayerRoom {
  id            String                  @id @default(cuid())
  code          String                  @unique
  gameKey       String
  maxPlayers    Int
  hostPlayerKey String
  status        MultiplayerRoomStatus   @default(LOBBY)
  state         Json
  expiresAt     DateTime
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  participants  MultiplayerParticipant[]
  events        MultiplayerRoomEvent[]
  chatMessages  SafeChatMessage[]
  reports       CommunityReport[]
  match         Match?

  @@index([gameKey, status, expiresAt])
}

model MultiplayerParticipant {
  id          String                       @id @default(cuid())
  roomId      String
  playerKey   String
  nickname    String
  avatarKey   String                       @default("spark")
  status      MultiplayerParticipantStatus @default(CONNECTED)
  state       Json?
  connectedAt DateTime                     @default(now())
  lastSeenAt  DateTime                     @updatedAt
  leftAt      DateTime?
  room        MultiplayerRoom              @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, playerKey])
  @@index([roomId, status])
}

model MultiplayerRoomEvent {
  id        String           @id @default(cuid())
  roomId    String
  playerKey String?
  type      String
  revision  Int
  payload   Json
  createdAt DateTime         @default(now())
  room      MultiplayerRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, revision])
  @@index([createdAt])
}

// Contratos de persistencia compartidos por cooperativo ahora y PvP después.
// El modo PVP_FUTURE no se expone al cliente hasta que exista reglamento y
// validación específica de cada juego.
model Match {
  id          String      @id @default(cuid())
  roomId      String?     @unique
  gameKey     String
  mode        MatchMode   @default(COOPERATIVE)
  status      MatchStatus @default(WAITING)
  state       Json
  result      Json?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  room        MultiplayerRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  players     MatchPlayer[]

  @@index([gameKey, mode, status])
}

model MatchPlayer {
  id        String            @id @default(cuid())
  matchId   String
  userId    String?
  playerKey String
  team      Int?
  status    MatchPlayerStatus @default(ACTIVE)
  score     Int               @default(0)
  state     Json?
  joinedAt  DateTime          @default(now())
  leftAt    DateTime?
  match     Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([matchId, playerKey])
  @@index([userId, joinedAt(sort: Desc)])
}
