# PostgreSQL para desarrollo local. No incluyas secretos reales en este archivo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aventura_vida?schema=public"

# Para la base de producción, configura DATABASE_URL en Vercel y ejecuta
# `pnpm exec prisma migrate deploy` desde un entorno autorizado con acceso a
# esa base. Nunca incluyas la URL ni secretos reales en Git.

# Sesiones de cuenta. Genera un valor largo y único para producción.
AUTH_SECRET="genera-un-secreto-largo-aleatorio-para-produccion"
AUTH_URL="http://localhost:3000"

# Protege la tarea diaria de contenido. Vercel Cron manda este valor como
# `Authorization: Bearer <CRON_SECRET>`; no lo expongas como NEXT_PUBLIC_.
CRON_SECRET="genera-otro-secreto-largo-exclusivo-para-el-cron"

# Fase 1 multijugador. En desarrollo, inicia `pnpm multiplayer:dev` en otra terminal.
MULTIPLAYER_PORT="3001"
MULTIPLAYER_ALLOWED_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_MULTIPLAYER_SERVER_URL="http://localhost:3001"

# Opcional: un proveedor de IA se integra únicamente desde el servidor y sus
# propuestas quedan en borrador hasta revisión editorial. No configures ambas
# claves si no usarás ese proveedor y nunca las expongas al navegador.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
