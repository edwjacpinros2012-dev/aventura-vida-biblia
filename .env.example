# PostgreSQL para desarrollo local. No incluyas secretos reales en este archivo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aventura_vida?schema=public"

# Se utilizarán en la Fase 2 al añadir autenticación.
AUTH_SECRET="genera-un-secreto-largo-aleatorio-para-produccion"
AUTH_URL="http://localhost:3000"

# Fase 1 multijugador. En desarrollo, inicia `pnpm multiplayer:dev` en otra terminal.
MULTIPLAYER_PORT="3001"
MULTIPLAYER_ALLOWED_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_MULTIPLAYER_SERVER_URL="http://localhost:3001"
